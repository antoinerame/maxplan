# Copie ce fichier en .env et renseigne ta clé.
# Clé API SNCF gratuite : https://numerique.sncf.com/startup/api/token-developpeur/
SNCF_TOKEN=ta-cle-api-sncf-ici
# Port hôte exposé -> http://localhost:HOST_PORT
HOST_PORT=8765

# Page privée des retours visiteurs : /admin/retours?token=<jeton> (laisser vide pour la désactiver)
FEEDBACK_TOKEN=

# Reverse proxys de confiance devant le site (1 derrière nginx/Caddy/Traefik, 0 sinon)
PROXY_HOPS=1
# Adresse d'écoute du port hôte (127.0.0.1 = seulement cette machine)
BIND=127.0.0.1
